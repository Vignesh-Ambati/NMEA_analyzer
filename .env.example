# Backend Core Server Configuration (FastAPI service)
VITE_BACKEND_PROTOCOL=https
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000
VITE_API_PREFIX=/api
VITE_BACKEND_URL=https://127.0.0.1:8000
VITE_BACKEND_PING_INTERVAL_MS=1800000

# Optional Local Frontend HTTPS Configuration (using self-generated certificates)
# Set to 'true' on your local development machine to serve the UI via https://localhost:3000
VITE_DEV_HTTPS=true
VITE_SSL_CERT_PATH=./certs/cert.pem
VITE_SSL_KEY_PATH=./certs/key.pem
